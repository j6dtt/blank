vertex="1" parent="1"><mxGeometry x="846" y="92" width="118" height="28" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;ellipse;" vertex="1" parent="1"><mxGeometry x="978" y="70" width="24" height="24" as="geometry"/></mxCell><mxCell id="c24" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="960" height="70" as="geometry"/></mxCell><mxCell id="c25" value="" style="rounded=0;fillColor=#d33c3c;strokeColor=none;opacity=100;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="6" height="70" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Likely: Outlook was not responding on LAPTOP-01 (up to 41 s)&lt;/b&gt;" style="text;html=1;fontSize=18;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="158" width="920" height="30" as="geometry"/></mxCell><mxCell id="c27" value="It happened within 5 min of 3 of the 4 slow actions. Outlook failed in AddinX.dll 2.1 (inside outlook.exe 16.0): Not responding." style="text;html=1;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="188" width="920" height="24" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;ellipse;" vertex="1" parent="1"><mxGeometry x="978" y="154" width="24" height="24" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=1;whiteSpace=wrap;html=1;fillCo