metry x="36" y="598" width="400" height="22" as="geometry"/></mxCell><mxCell id="c66" value="• Outlook was not responding on LAPTOP-01 (up to 41 s): &lt;b&gt;at 3 of 4 slow actions&lt;/b&gt;, from Oct 27, 08:40 AM" style="text;html=1;fontSize=11;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="36" y="624" width="920" height="20" as="geometry"/></mxCell><mxCell id="c67" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="56" y="648" width="900" height="64" as="geometry"/></mxCell><mxCell id="c68" value="" style="rounded=0;fillColor=#2563eb;strokeColor=none;opacity=100;" vertex="1" parent="1"><mxGeometry x="56" y="648" width="3" height="64" as="geometry"/></mxCell><mxCell id="c69" value="&lt;b&gt;Why:&lt;/b&gt;&lt;br&gt;◦ Outlook failed in AddinX.dll 2.1 (inside outlook.exe 16.0): Not responding.&lt;br&gt;◦ Changed on LAPTOP-01 in the 14 days before Oct 27: Oct 26 AddinX Updated 2.0 → 2.1 (same name as the failing part)." style="text;html=1;fontSize=11;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="68" y="650" width="880" height="60" as="geometry"/></mxCell><mxCell id="c70" value="• LAPTOP-01&#x27;s disk could not keep up (queue 6.2, limit 2): &lt;b&gt;at 2 of 4 slow actions&lt;/b&gt;, from Oct 27, 08:41 AM" style="text;html=1;fontSize=11;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="36" y="718" width="920" height="20" as="geometry"/></mxCell><mxCell id="c71" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="56" y="742" width="900" height="40" as="geometry"/></mxCell><mxCell id="c72" value="" style="rounded=0;fillColor=#2563eb;strokeColor=none;opacity=100;" vertex="1" parent="1"><mxGeometry x="56" y="742" width="3" height="40" as="geometry"/></mxCell><mxCell id="c73" value="&lt;b&gt;Why:&lt;/b&gt; ◦ Busiest processes then: MsMpEng.exe (disk I/O 48.2), OneDrive.exe (disk I/O 6.1)." style="text;html=1;fontSize=11;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="68" y="744" width="880" height="36" as="geometry"/></mxCell><mxCell id="c74" value="• 9 other problem(s) happened only at other times, not near a slow action.&lt;br&gt;• The network was not checked: this PC&#x27;s address is not in any NetIM subnet." style="text;html=1;fontSize=11;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="36" y="790" width="920" height="46" as="geometry"/></mxCell><mxCell id="c75" value="&lt;b&gt;4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;ellipse;" vertex="1" parent="1"><mxGeometry x="978" y="594" width="24" height="24" as="geometry"/></mxCell><mxCell id="c76" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="858" width="960" height="96" as="geometry"/></mxCell><mxCell id="c77" value="&lt;b&gt;What to do&lt;/b&gt;" style="text;html=1;fontSize=13;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="36" y="866" width="300" height="22" as="geometry"/></mxCell><mxCell id="c78" value="• 41 other PCs fail the same way: treat it as an AddinX.dll problem (version, update, vendor), not this PC alone.&lt;br&gt;• Check the AddinX change of 2026-10-26 on LAPTOP-01: it came before the first failure.&lt;br&gt;• On LAPTOP-01: look at MsMpEng.exe, the busiest process at those times." style="text;html=1;fontSize=11;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="36" y="890" width="920" height="60" as="geometry"/></mxCell><mxCell id="c79" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="970" width="960" height="270" as="geometry"/></mxCell><mxCell id="c80" value="&lt;b&gt;Timeline&lt;/b&gt;" style="text;html=1;fontSize=13;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="36" y="978" width="300" height="22" as="geometry"/></mxCell><mxCell id="c81" value="" style="endArrow=none;html=1;strokeColor=#dde1e7;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="1010.0" as="sourcePoint"/><mxPoint x="960" y="1010.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c82" value="100 s" style="text;html=1;fontSize=9;fontColor=#5d6676;align=right;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="58" y="1002.0" width="46" height="16" as="geometry"/></mxCell><mxCell id="c83" value="" style="endArrow=none;html=1;strokeColor=#dde1e7;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="1040.0" as="sourcePoint"/><mxPoint x="960" y="1040.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c84" value="75 s" style="text;html=1;fontSize=9;fontColor=#5d6676;align=right;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="58" y="1032.0" width="46" height="16" as="geometry"/></mxCell><mxCell id="c85" value="" style="endArrow=n