1;whiteSpace=wrap;html=1;fillColor=#8b5cf6;strokeColor=#8b5cf6;fontSize=11;fontColor=#ffffff;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;arcSize=50;" vertex="1" parent="1"><mxGeometry x="162" y="1352.0" width="64" height="20" as="geometry"/></mxCell><mxCell id="c156" value="LAPTOP-01&#x27;s disk could not keep up (queue 6.2, limit 2)" style="text;html=1;fontSize=11;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="240" y="1348" width="512" height="28" as="geometry"/></mxCell><mxCell id="c157" value="Oct 27, 08:41 AM – Oct 28, 11:50 AM" style="text;html=1;fontSize=11;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="760" y="1348" width="192" height="28" as="geometry"/></mxCell><mxCell id="c158" value="" style="endArrow=none;html=1;strokeColor=#dde1e7;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="36" y="1376" as="sourcePoint"/><mxPoint x="956" y="1376" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c159" value="&lt;b&gt;Show 9 problem(s) at other times ▸&lt;/b&gt;" style="text;html=1;fontSize=12;fontColor=#2563eb;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="36" y="1386" width="400" height="24" as="geometry"/></mxCell><mxCell id="c160" value="&lt;b&gt;6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;ellipse;" vertex="1" parent="1"><mxGeometry x="978" y="1260" width="24" height="24" as="geometry"/></mxCell><mxCell id="c161" value="&lt;b&gt;Details for IT ▸&lt;/b&gt;" style="text;html=1;fontSize=12;fontColor=#2563eb;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="1432" width="300" height="24" as="geometry"/></mxCell><mxCell id="c162" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="1462" width="960" height="110" as="geometry"/></mxCell><mxCell id="c163" value="Slow = Aternity marked it Major.&lt;br&gt;A problem counts for a slow action recorded up to 5 min before or after it. A crash, hang or health event of one application counts only for that application.&lt;br&gt;Aternity UXI: avg 7.9, lowest 4.1.&lt;br&gt;&lt;br&gt;&lt;b&gt;LAPTOP-01&lt;/b&gt; &amp;nbsp;Not Mapped · Windows 11 &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; NetIM object checked: none on this PC&#x27;s path." style="text;html=1;fontSize=11;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="36" y="1470" width="920" height="104" as="geometry"/></mxCell><mxCell id="c164" value="&lt;b&gt;7&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;ellipse;" vertex="1" parent="1"><mxGeometry x="978" y="1466" width="24" height="24" as="geometry"/></mxCell><mxCell id="c165" value="&lt;b&gt;How to use it&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="1030" y="20" width="350" height="24" as="geometry"/></mxCell><mxCell id="c166" value="&lt;b&gt;1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;ellipse;" vertex="1" parent="1"><mxGeometry x="1030" y="50" width="24" height="24" as="geometry"/></mxCell><mxCell id="c167" value="Fill in a user name or a device (or both), the time range and, if you like, one application. &#x27;Match within&#x27; = how many minutes before or after a slow action a problem still counts. Click Investigate: a progress list shows each step until the result appears." style="text;html=1;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="1062" y="48" width="318" height="104" as="geometry"/></mxCell><mxCell id="c168" value="&lt;b&gt;2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;ellipse;" vertex="1" parent="1"><mxGeometry x="1030" y="164" width="24" height="24" as="geometry"/></mxCell><mxCell id="c169" value="The answer: the problem seen at the most slow actions. Red edge = Likely (more than half), amber = Possibly, grey = Cause not found, green = nothing was slow." style="text;html=1;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="1062" y="162" width="318" height="72" as="geometry"/></mxCell><mxCell id="c170" value="&lt;b&gt;3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;ellipse;" vertex="1" parent="1"><mxGeometry x="1030" y="246" width="24" height="24" as="geometry"/></mxCell><mxCell id="c171" value="Who else is affected? For an app failure: how many other PCs had the same failure, and on which version. &#x27;Show who&#x27; opens the list below (PC, user, version, times, last seen); click again to close. For a network problem it lists the other slow users and the network point they share instead." style="text;html=1;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="1062" y="244" width="318" height="120" as="geometry"/></mxCell><mxCell id="c172" value="&lt;b&gt;4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;ellipse;" vertex="1" parent="1"><mxGeometry x="1030" y="376" width="24" height="24" as="geometry"/></mxCell><mxCell id="c173" value="The main part: each problem at the slow actions, and under it what caused it, from Aternity&#x27;s own records: where the app failed (module and version), whether other PCs fail the same way, what was installed or updated before, and the busiest processes. &#x27;What to do&#x27; follows from these." style="text;html=1;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="1062" y="374" width="318" height="120" as="geometry"/></mxCell><mxCell id="c174" value="&lt;b&gt;5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;ellipse;" vertex="1" parent="1"><mxGeometry x="1030" y="506" width="24" height="24" as="geometry"/></mxCell><mxCell id="c175" value="Every action as a dot (red = slow) and every problem as a mark in its lane. A solid mark is near a slow action; a faded one is not. Hover any dot or mark for its date, time and value." style="text;html=1;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="1062" y="504" width="318" height="72" as="geometry"/></mxCell><mxCell id="c176" value="&lt;b&gt;6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;ellipse;" vertex="1" parent="1"><mxGeometry x="1030" y="588" width="24" height="24" as="geometry"/></mxCell><mxCell id="c177" value="Only the problems at slow actions, with &#x27;at N of M&#x27;. &#x27;Show N problem(s) at other times&#x27; opens the rest; click again to close." style="text;html=1;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="1062" y="586" width="318" height="56" as="geometry"/></mxCell><mxCell id="c178" value="&lt;b&gt;7&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;ellipse;" vertex="1" parent="1"><mxGeometry x="1030" y="654" width="24" height="24" as="geometry"/></mxCell><mxCell id="c179" value="Closed at first. Opens the rules used, the PC and the NetIM objects checked. Click again to close." style="text;html=1;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="1062" y="652" width="318" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>