<mxfile host="drawio"><diagram name="04-start-ups-logic" id="04-start-ups-logic"><mxGraphModel dx="1660" dy="939" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="939" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Start-ups tab: every rule behind it&lt;/b&gt;" style="text;html=1;fontSize=20;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="860" height="34" as="geometry"/></mxCell><mxCell id="c4" value="How long boots and logons took, against each PC&#x27;s own usual, and what took the time. Read top to bottom." style="text;html=1;fontSize=12;fontColor=#5d6676;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c5" value="Timing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1000" y="22" width="62" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1070" y="22" width="49" height="24" as="geometry"/></mxCell><mxCell id="c7" value="Worked out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1127" y="22" width="90" height="24" as="geometry"/></mxCell><mxCell id="c8" value="Safety rule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1225" y="22" width="96" height="24" as="geometry"/></mxCell><mxCell id="c9" value="Result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1329" y="22" width="62" height="24" as="geometry"/></mxCell><mxCell id="c10" value="On the page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1399" y="22" width="96" height="24" as="geometry"/></mxCell><mxCell id="c11" value="By a click" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1503" y="22" width="90" height="24" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="1620" height="97" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;1. When&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="94" width="136" height="24" as="geometry"/></mxCell><mxCell id="c14" value="Only when asked" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="118" width="136" height="57" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;How it starts&lt;/b&gt;&lt;br&gt;The Show button for a window of time, for everyone or one user or PC; &quot;Open in Start-ups&quot; from the Care list, an investigation or Ask anything." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="98" width="468" height="69" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;How it runs&lt;/b&gt;&lt;br&gt;As a job in the background, like an investigation; kept 10 minutes when done." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="676" y="98" width="468" height="69" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Nothing is saved&lt;/b&gt;&lt;br&gt;It is read from Aternity each time." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1162" y="98" width="468" height="69" as="geometry"/></mxCell><mxCell id="c18" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="181" as="sourcePoint"/><mxPoint x="830" y="207" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="207" width="1620" height="112" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;2. Read&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="217" width="136" height="24" as="geometry"/></mxCell><mxCell id="c21" value="From Aternity only" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="241" width="136" height="72" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Start-up rows&lt;/b&gt;&lt;br&gt;Each boot or logon Aternity measured: the PC, the user, the time, how long, and Aternity&#x27;s own type name. No type name is assumed by us." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="221" width="346" height="84" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Their parts&lt;/b&gt;&lt;br&gt;What ran during a start-up and how long each part took, with Aternity&#x27;s own measure of how much longer than expected." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="221" width="346" height="84" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;History&lt;/b&gt;&lt;br&gt;Each PC&#x27;s start-ups of the 30 days before, for its own usual." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="221" width="346" height="84" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Change log&lt;/b&gt;&lt;br&gt;Software installed, updated or removed on the PC before a start-up became slow." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="221" width="346" height="84" as="geometry"/></mxCell><mxCell id="c26" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="319" as="sourcePoint"/><mxPoint x="830" y="345" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="345" width="1620" height="214" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;3. Worked out&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="355" width="136" height="24" as="geometry"/></mxCell><mxCell id="c29" value="A to G" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="379" width="136" height="174" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;A. What is one start-up&lt;/b&gt;&lt;br&gt;Rows of one PC within an hour, with no type twice, are one start-up: one line, a column per type." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="359" width="346" height="84" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;B. Per type, everyone&lt;/b&gt;&lt;br&gt;The typical time, and the time 1 in 10 are over. That second number is given only from 10 measured start-ups; with fewer the slowest is shown." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="359" width="346" height="84" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;C. Against the PC&#x27;s own usual&lt;/b&gt;&lt;br&gt;Each start-up against that PC&#x27;s earlier ones (5 needed). There is no &quot;slow&quot; threshold of ours." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="359" width="346" height="84" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;D. What took the time&lt;/b&gt;&lt;br&gt;A part belongs to the latest start-up of its PC at or before it, within an hour. Looked up for the 20 slowest; the part Aternity found the most degraded is named." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="359" width="346" height="84" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;E. Main causes&lt;/b&gt;&lt;br&gt;A part that was longer than normal on every PC that had it (up to 3): not one PC&#x27;s problem." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="461" width="468" height="84" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;F. Since when&lt;/b&gt;&lt;br&gt;The earliest point from which every start-up of a type took longer than 9 in 10 of those before it (5 earlier needed), and the software changes just before. Looked for on the 10 slowest." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="676" y="461" width="468" height="84" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;G. Virtual desktops&lt;/b&gt;&lt;br&gt;They are pooled: a user&#x27;s start-ups on their virtual desktops are compared with each other, not with one desktop&#x27;s history of many users." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1162" y="461" width="468" height="84" as="geometry"/></mxCell><mxCell id="c37" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="567" width="1620" height="97" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Safety rules&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="577" width="136" height="24" as="geometry"/></mxCell><mxCell id="c39" value="" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="601" width="136" height="57" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Nothing read is not &quot;no start-ups&quot;&lt;/b&gt;&lt;br&gt;When the read failed, the tab shows the warnings." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="581" width="468" height="69" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;No unit is promised&lt;/b&gt;&lt;br&gt;The time unit is read from live values as seconds; it is not documented by Riverbed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="676" y="581" width="468" height="69" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;A calm start-up is not a problem&lt;/b&gt;&lt;br&gt;In an investigation, a start-up with no slow part that is normal for its PC is only mentioned, never an issue." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1162" y="581" width="468" height="69" as="geometry"/></mxCell><mxCell id="c43" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="664" as="sourcePoint"/><mxPoint x="830" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="690" width="1620" height="97" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;4. On the page&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="700" width="136" height="24" as="geometry"/></mxCell><mxCell id="c46" value="" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="724" width="136" height="57" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;The list&lt;/b&gt;&lt;br&gt;Each start-up: when, PC, user, each type&#x27;s time, against the PC&#x27;s usual, and what took the time." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="704" width="468" height="69" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Per type and main causes&lt;/b&gt;&lt;br&gt;The typical time and &quot;1 in 10 over&quot; per type; the main causes across PCs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="676" y="704" width="468" height="69" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;By location&lt;/b&gt;&lt;br&gt;The same start-ups grouped by the location Aternity gives each PC." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1162" y="704" width="468" height="69" as="geometry"/></mxCell><mxCell id="c50" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="787" as="sourcePoint"/><mxPoint x="830" y="813" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c51" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="813" width="1620" height="82" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;5. By a click&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="823" width="136" height="24" as="geometry"/></mxCell><mxCell id="c53" value="" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="847" width="136" height="42" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;A start-up&#x27;s why&lt;/b&gt;&lt;br&gt;Its parts, the PC&#x27;s history, and the changes before it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="827" width="468" height="54" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;Investigate&lt;/b&gt;&lt;br&gt;Runs an investigation of that user and PC around the start-up." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="676" y="827" width="468" height="54" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;Explain&lt;/b&gt;&lt;br&gt;On every panel, as on the other tabs. Link: #startups." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1162" y="827" width="468" height="54" as="geometry"/></mxCell><mxCell id="c57" value="The numbers are the code&#x27;s own settings on the day the drawing was made. Names of PCs and users are never in a saved count unless said." style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="903" width="1620" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>