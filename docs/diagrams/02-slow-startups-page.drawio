olor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="260" y="1084" width="112" height="28" as="geometry"/></mxCell><mxCell id="c140" value="33 s" style="text;html=1;fontSize=11;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="380" y="1084" width="172" height="28" as="geometry"/></mxCell><mxCell id="c141" value="30 s" style="text;html=1;fontSize=11;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="560" y="1084" width="172" height="28" as="geometry"/></mxCell><mxCell id="c142" value="70 s" style="text;html=1;fontSize=11;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="740" y="1084" width="212" height="28" as="geometry"/></mxCell><mxCell id="c143" value="" style="endArrow=none;html=1;strokeColor=#dde1e7;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="36" y="1112" as="sourcePoint"/><mxPoint x="956" y="1112" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c144" value="&lt;b&gt;5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;ellipse;" vertex="1" parent="1"><mxGeometry x="978" y="968" width="24" height="24" as="geometry"/></mxCell><mxCell id="c145" value="&lt;b&gt;How to use it&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="1030" y="20" width="350" height="24" as="geometry"/></mxCell><mxCell id="c146" value="&lt;b&gt;1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;ellipse;" vertex="1" parent="1"><mxGeometry x="1030" y="50" width="24" height="24" as="geometry"/></mxCell><mxCell id="c147" value="Search everyone, or narrow to a user, a PC or an Aternity location, between Start and End (last 24 hours by default). Click &#x27;Find slow start-ups&#x27;: a progress list shows each step until the result appears." style="text;html=1;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="1062" y="48" width="318" height="88" as="geometry"/></mxCell><mxCell id="c148" value="&lt;b&gt;2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;ellipse;" vertex="1" parent="1"><mxGeometry x="1030" y="148" width="24" height="24" as="geometry"/></mxCell><mxCell id="c149" value="The slowest start-up in one line, then one card per measurement type, named as Aternity names them: the typical time and the time 1 in 10 start-ups are slower than." style="text;html=1;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="1062" y="146" width="318" height="72" as="geometry"/></mxCell><mxCell id="c150" value="&lt;b&gt;3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;ellipse;" vertex="1" parent="1"><mxGeometry x="1030" y="230" width="24" height="24" as="geometry"/></mxCell><mxCell id="c151" value="Main causes: the parts Aternity measured as most &#x27;longer than normal&#x27; in the 10 slowest start-ups. Each line counts every PC where that part was longer than normal in the same Start/End, by location. &#x27;Show who&#x27; opens the list of those PCs; &#x27;Hide who&#x27; closes it." style="text;html=1;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="1062" y="228" width="318" height="104" as="geometry"/></mxCell><mxCell id="c152" value="&lt;b&gt;4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;ellipse;" vertex="1" parent="1"><mxGeometry x="1030" y="344" width="24" height="24" as="geometry"/></mxCell><mxCell id="c153" value="One row per start-up, slowest first by the type marked ▼. With one user or PC searched, each value shows &#x27;usual N s&#x27; under it (that PC&#x27;s 30 days before Start). Rows with ▸ open what took the time and, for the 10 slowest, why: the slowest part, what changed on the PC in the 14 days before, and which main cause it belongs to. Click again to close." style="text;html=1;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="1062" y="342" width="318" height="136" as="geometry"/></mxCell><mxCell id="c154" value="&lt;b&gt;5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;ellipse;" vertex="1" parent="1"><mxGeometry x="1030" y="490" width="24" height="24" as="geometry"/></mxCell><mxCell id="c155" value="Shown when there is more than one location: the typical time of each type per location, slowest first." style="text;html=1;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="1062" y="488" width="318" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>