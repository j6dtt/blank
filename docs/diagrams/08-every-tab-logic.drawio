<mxfile host="drawio"><diagram name="08-every-tab-logic" id="08-every-tab-logic"><mxGraphModel dx="1660" dy="1044" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1044" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Ask anything, Explain and the top bar: every rule behind them&lt;/b&gt;" style="text;html=1;fontSize=20;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="860" height="34" as="geometry"/></mxCell><mxCell id="c4" value="What every tab shares: the one chat, the explanation of a panel, the connection lights, the names offered as you type." style="text;html=1;fontSize=12;fontColor=#5d6676;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c5" value="Timing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1000" y="22" width="62" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1070" y="22" width="49" height="24" as="geometry"/></mxCell><mxCell id="c7" value="Worked out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1127" y="22" width="90" height="24" as="geometry"/></mxCell><mxCell id="c8" value="Safety rule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1225" y="22" width="96" height="24" as="geometry"/></mxCell><mxCell id="c9" value="Result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1329" y="22" width="62" height="24" as="geometry"/></mxCell><mxCell id="c10" value="On the page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1399" y="22" width="96" height="24" as="geometry"/></mxCell><mxCell id="c11" value="By a click" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1503" y="22" width="90" height="24" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="1620" height="112" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;1. When&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="94" width="136" height="24" as="geometry"/></mxCell><mxCell id="c14" value="" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="118" width="136" height="72" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Ask anything&lt;/b&gt;&lt;br&gt;Only when a question is asked. It runs as a job in the background; the page shows each look-up as it starts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="98" width="346" height="84" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Explain&lt;/b&gt;&lt;br&gt;Only at a click on a panel&#x27;s &quot;Explain&quot;. Nothing is saved." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="98" width="346" height="84" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Connection lights&lt;/b&gt;&lt;br&gt;One small read of each system every 60 seconds (it waits 15 seconds at most, with no second try)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="98" width="346" height="84" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Names&lt;/b&gt;&lt;br&gt;Every username and PC name seen in Aternity&#x27;s activity, kept by the Today reader. A name not seen for 8 days is dropped." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="98" width="346" height="84" as="geometry"/></mxCell><mxCell id="c19" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="196" as="sourcePoint"/><mxPoint x="830" y="222" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="222" width="1620" height="112" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;2. The AI gets&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="232" width="136" height="24" as="geometry"/></mxCell><mxCell id="c22" value="It reads nothing itself" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="256" width="136" height="72" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;The question&lt;/b&gt;&lt;br&gt;With the last 6 questions and answers, and a line of what was looked up for them." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="236" width="346" height="84" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;The tab that is open&lt;/b&gt;&lt;br&gt;As the page shows it, with our written meaning of each term on that tab." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="236" width="346" height="84" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Aternity&#x27;s own names&lt;/b&gt;&lt;br&gt;The kinds of event Aternity uses (up to 80, the most PCs first), so the AI picks the ones meant: &quot;hard drive issue&quot; is not a name Aternity has." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="236" width="346" height="84" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Look-ups&lt;/b&gt;&lt;br&gt;A list of look-ups our code can run. The AI asks for them; our code counts and hands back rows." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="236" width="346" height="84" as="geometry"/></mxCell><mxCell id="c27" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="334" as="sourcePoint"/><mxPoint x="830" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="360" width="1620" height="214" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;3. Worked out&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="370" width="136" height="24" as="geometry"/></mxCell><mxCell id="c30" value="A to F" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="394" width="136" height="174" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;A. Look-ups from what is already held&lt;/b&gt;&lt;br&gt;No read of Aternity: find a user or PC by name · events · measured actions · the day&#x27;s overview · what a term means · the tab on screen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="374" width="468" height="84" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;B. Look-ups that read Aternity now&lt;/b&gt;&lt;br&gt;Who logged in where · start-ups · a PC&#x27;s software · a PC&#x27;s changes · programs per PC · the Software tab&#x27;s look-ups (versions, compare, before and after, PCs) · one whole investigation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="676" y="374" width="468" height="84" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;C. Limits per question&lt;/b&gt;&lt;br&gt;8 look-ups, 5 of them reading Aternity, 1 investigation (4 hours unless asked, 24 at most). A step shows up to 150 rows." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1162" y="374" width="468" height="84" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;D. The answer&lt;/b&gt;&lt;br&gt;One line that answers, 2 to 4 points, a last line &quot;Next: ...&quot; (at most 7 lines). In the AI&#x27;s own words, from the rows it was handed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="476" width="468" height="84" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;E. Explain&lt;/b&gt;&lt;br&gt;A panel&#x27;s own lines and our meaning of each term go to the AI, which words them. A question can be asked under it. For a Software comparison our own walk-through is shown first." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="676" y="476" width="468" height="84" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;F. A name sent the wrong way&lt;/b&gt;&lt;br&gt;A name known only as a user, sent as a PC (or the other way), is looked up as what it is, and that is said." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1162" y="476" width="468" height="84" as="geometry"/></mxCell><mxCell id="c37" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="582" width="1620" height="127" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Safety rules&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="592" width="136" height="24" as="geometry"/></mxCell><mxCell id="c39" value="They guard the answers above" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="616" width="136" height="87" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Numbers are checked&lt;/b&gt;&lt;br&gt;Ask anything: a number in none of the look-ups, or a comparison the AI worked out (&quot;twice as many&quot;), is marked on the answer. Explain: such an answer is refused and our own written meanings are shown." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="596" width="346" height="99" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;A failed look-up is said&lt;/b&gt;&lt;br&gt;It is a step that says what failed, never a lost question. A read cut short says its counts are partial." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="596" width="346" height="99" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;No AI service&lt;/b&gt;&lt;br&gt;Explain shows our own written meanings. The lights prove connection and login, not the quality of a model&#x27;s answers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="596" width="346" height="99" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;No login on the main page&lt;/b&gt;&lt;br&gt;So Ask anything never asks Active Directory: on the main page only the Care list does, for its own users." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="596" width="346" height="99" as="geometry"/></mxCell><mxCell id="c44" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="709" as="sourcePoint"/><mxPoint x="830" y="735" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="735" width="1620" height="127" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;4. On the page&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="745" width="136" height="24" as="geometry"/></mxCell><mxCell id="c47" value="On every tab" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="769" width="136" height="87" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Ask anything&lt;/b&gt;&lt;br&gt;At the bottom of every tab, with examples for the tab that is open. Answers stay when the tab changes. &quot;What I looked at&quot; lists every step." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="749" width="346" height="99" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Explain&lt;/b&gt;&lt;br&gt;At the bottom right of a panel: a dialog with the explanation, &quot;What the terms mean&quot; and a box for a question." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="749" width="346" height="99" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Top bar&lt;/b&gt;&lt;br&gt;The lights for Aternity, NetIM and each AI service: green, amber (the model is not in the service&#x27;s list), red and flashing (no answer, or login refused). The look: Parchment | Dark." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="749" width="346" height="99" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Tabs&lt;/b&gt;&lt;br&gt;Today · Care list · Investigate · Start-ups · Software · Inventory. Each has a link and opens where it was left. Scrolled down, the bar stays as one slim row with &quot;Top&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="749" width="346" height="99" as="geometry"/></mxCell><mxCell id="c52" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="862" as="sourcePoint"/><mxPoint x="830" y="888" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="888" width="1620" height="112" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;5. By a click&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="898" width="136" height="24" as="geometry"/></mxCell><mxCell id="c55" value="" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="922" width="136" height="72" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;A row of a step&lt;/b&gt;&lt;br&gt;&quot;Investigate&quot; runs an investigation of that user and PC. &quot;Open this investigation&quot; shows the one the chat ran, without a second run." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="902" width="346" height="84" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;A light&lt;/b&gt;&lt;br&gt;One &quot;Connections&quot; dialog: since when, the reply time, which model the chat uses, and what in config.yaml is not used." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="902" width="346" height="84" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;A name box&lt;/b&gt;&lt;br&gt;Names are offered as you type (up to 20); any name can still be typed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="902" width="346" height="84" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;The look&lt;/b&gt;&lt;br&gt;Kept in the browser; the main page and the admin page share it when opened under one address. Until someone picks, the PC&#x27;s own light or dark setting decides." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="902" width="346" height="84" as="geometry"/></mxCell><mxCell id="c60" value="The numbers are the code&#x27;s own settings on the day the drawing was made. Names of PCs and users are never in a saved count unless said." style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="1008" width="1620" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>