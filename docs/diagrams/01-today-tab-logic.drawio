<mxfile host="drawio"><diagram name="01-today-tab-logic" id="01-today-tab-logic"><mxGraphModel dx="1660" dy="1089" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1089" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Today tab: every rule behind it&lt;/b&gt;" style="text;html=1;fontSize=20;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="860" height="34" as="geometry"/></mxCell><mxCell id="c4" value="What Aternity itself rated today, against the same kind of day before. Read top to bottom." style="text;html=1;fontSize=12;fontColor=#5d6676;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c5" value="Timing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1000" y="22" width="62" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1070" y="22" width="49" height="24" as="geometry"/></mxCell><mxCell id="c7" value="Worked out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1127" y="22" width="90" height="24" as="geometry"/></mxCell><mxCell id="c8" value="Safety rule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1225" y="22" width="96" height="24" as="geometry"/></mxCell><mxCell id="c9" value="Result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1329" y="22" width="62" height="24" as="geometry"/></mxCell><mxCell id="c10" value="On the page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1399" y="22" width="96" height="24" as="geometry"/></mxCell><mxCell id="c11" value="By a click" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1503" y="22" width="90" height="24" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="1620" height="127" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;1. When&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="94" width="136" height="24" as="geometry"/></mxCell><mxCell id="c14" value="One background reader for the whole app" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="118" width="136" height="87" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Every few minutes&lt;/b&gt;&lt;br&gt;The reader reads Aternity every 15 minutes unless config.yaml sets another pace (5 to 60). A read starts that long after the one before started, however long a read takes. The names list and the Care list go with it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="98" width="346" height="99" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Which hours&lt;/b&gt;&lt;br&gt;At start: the last 24 hours, an hour at a time. Then the current hour at each read, and each hour once more 15 minutes after it ends, because Aternity sends rows late." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="98" width="346" height="99" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Health events&lt;/b&gt;&lt;br&gt;Today&#x27;s at each read. The 14 days before: once a day." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="98" width="346" height="99" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;What is kept&lt;/b&gt;&lt;br&gt;Each finished day&#x27;s counts are saved for 60 days (counts and application names; no user, no PC), because Aternity keeps activity only about 8 days. Assessments: 15 days." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="98" width="346" height="99" as="geometry"/></mxCell><mxCell id="c19" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="211" as="sourcePoint"/><mxPoint x="830" y="237" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="237" width="1620" height="127" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;2. Read&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="247" width="136" height="24" as="geometry"/></mxCell><mxCell id="c22" value="From Aternity only" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="271" width="136" height="87" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Measured actions&lt;/b&gt;&lt;br&gt;Each action a user did in an application: the application, the activity, how long, Aternity&#x27;s own rating (the worst is Major), the PC, the user, virtual or physical." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="251" width="346" height="99" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Health events&lt;/b&gt;&lt;br&gt;Events Aternity recorded on a PC, with its severity (Critical or Major make tiles), the application, the failing part and how many times." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="251" width="346" height="99" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Start-ups&lt;/b&gt;&lt;br&gt;Boots and logons with their time, per Aternity type. Today&#x27;s again every 55 minutes, each day before once." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="251" width="346" height="99" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;AI service&lt;/b&gt;&lt;br&gt;Only to word the assessment and answers. It is given counts and names our code counted; it reads nothing itself." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="251" width="346" height="99" as="geometry"/></mxCell><mxCell id="c27" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="364" as="sourcePoint"/><mxPoint x="830" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="390" width="1620" height="229" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;3. Worked out&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="400" width="136" height="24" as="geometry"/></mxCell><mxCell id="c30" value="Counts only, A to F" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="424" width="136" height="189" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;A. Active users and PCs&lt;/b&gt;&lt;br&gt;A user or PC with at least one measured action, any rating, each once. PCs split virtual / physical by Aternity&#x27;s own mark. Shown for today, and for the last full hour with this one so far." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="404" width="468" height="84" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;B. Event tiles&lt;/b&gt;&lt;br&gt;One tile per kind of Critical or Major event today: the PCs it hit, each once. Other events: the 10 on the most PCs, in a table." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="676" y="404" width="468" height="84" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;C. Slow actions&lt;/b&gt;&lt;br&gt;Actions Aternity rated Major: per hour, and per application (top 10)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1162" y="404" width="468" height="84" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;D. The usual&lt;/b&gt;&lt;br&gt;Each count is set against the same kind of day before (working Monday to Friday, or weekend): the latest 5 such days, up to the same time of day. With 3 or more of them it says &quot;more than any of them&quot;, &quot;fewer than any&quot; or &quot;as usual&quot;. Only days read in full count." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="506" width="468" height="99" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;E. Three small charts&lt;/b&gt;&lt;br&gt;One point per hour of today, with a band from the lowest to the highest of the same hour on those days: the share of actions rated Major (needs 50 actions in the hour), PCs with a crash so far, and the typical logon time (needs 5 start-ups)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="676" y="506" width="468" height="99" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;F. The assessment&lt;/b&gt;&lt;br&gt;At 06:00, 09:00, 12:00, 15:00, 18:00. Our code counts the facts; the verdict and what to look at first follow fixed rules (a verdict needs 5 PCs). Reach: isolated under 5 PCs, widespread from 50, limited between. The AI words it under Changed / Watch / Earlier / Start-ups." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1162" y="506" width="468" height="99" as="geometry"/></mxCell><mxCell id="c37" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="627" width="1620" height="112" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Safety rules&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="637" width="136" height="24" as="geometry"/></mxCell><mxCell id="c39" value="They guard the counts above" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="661" width="136" height="72" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;A failed read is never &quot;nothing&quot;&lt;/b&gt;&lt;br&gt;A read that failed or was cut short is counted as failed: the &quot;last good read&quot; time does not move, and the tab says which hours are missing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="641" width="346" height="84" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;A day not read in full&lt;/b&gt;&lt;br&gt;It is left out of the usual, and on the week chart it is a gap, never 0. It had counted as a quiet day." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="641" width="346" height="84" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;The AI&#x27;s words are checked&lt;/b&gt;&lt;br&gt;A number or a fixed word (isolated, widespread, above its usual range) that our lines do not give: the AI&#x27;s text is refused and our own text is shown." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="641" width="346" height="84" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;The reader never stops&lt;/b&gt;&lt;br&gt;An error the code did not expect is logged and the reader goes on to the next read." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="641" width="346" height="84" as="geometry"/></mxCell><mxCell id="c44" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="739" as="sourcePoint"/><mxPoint x="830" y="765" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="765" width="1620" height="142" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;4. On the page&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="775" width="136" height="24" as="geometry"/></mxCell><mxCell id="c47" value="The Today tab, top to bottom" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="799" width="136" height="102" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Assessment box&lt;/b&gt;&lt;br&gt;The verdict in its colour, the words, &quot;Written at HH:MM&quot;. Beside it: Yesterday in short (written once) and the week, Monday to Sunday, this week and last: PCs a day with a Critical event, a Major event, and Major slow actions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="779" width="346" height="114" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Active strip and charts&lt;/b&gt;&lt;br&gt;Active users and PCs now and today. Then the three small charts from E." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="779" width="346" height="114" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Tiles and tables&lt;/b&gt;&lt;br&gt;The Critical or Major event tiles with their usual; other crashes; slow actions per hour and per application." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="779" width="346" height="114" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Ask anything&lt;/b&gt;&lt;br&gt;The one chat, at the bottom of every tab. It is told which tab is open and what it shows." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="779" width="346" height="114" as="geometry"/></mxCell><mxCell id="c52" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="907" as="sourcePoint"/><mxPoint x="830" y="933" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="933" width="1620" height="112" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;5. By a click&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="943" width="136" height="24" as="geometry"/></mxCell><mxCell id="c55" value="Names of PCs and users appear only here" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="967" width="136" height="72" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;Who is behind a tile or row&lt;/b&gt;&lt;br&gt;The users and PCs behind it, most first (50 at most), from rows the reader already holds: no extra read of Aternity." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="947" width="346" height="84" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;Investigate&lt;/b&gt;&lt;br&gt;Runs an investigation of that user and PC: from 30 minutes before their first Major action to 30 after the last, or 60 minutes around an event." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="947" width="346" height="84" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;Explain&lt;/b&gt;&lt;br&gt;A panel&#x27;s own lines and our meaning of each term go to the AI, which words them. A number not in the lines: our own words instead." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="947" width="346" height="84" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;Links&lt;/b&gt;&lt;br&gt;#today opens this tab. Each tab opens where it was left." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="947" width="346" height="84" as="geometry"/></mxCell><mxCell id="c60" value="The numbers are the code&#x27;s own settings on the day the drawing was made. Names of PCs and users are never in a saved count unless said." style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="1053" width="1620" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>