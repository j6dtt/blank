<mxfile host="drawio"><diagram name="05-software-tab-logic" id="05-software-tab-logic"><mxGraphModel dx="1660" dy="1920" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1920" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Software tab: every rule behind it&lt;/b&gt;" style="text;html=1;fontSize=20;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="860" height="34" as="geometry"/></mxCell><mxCell id="c4" value="What is installed, on which versions, and where a version has more problems. Read top to bottom." style="text;html=1;fontSize=12;fontColor=#5d6676;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c5" value="Timing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1000" y="22" width="62" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1070" y="22" width="49" height="24" as="geometry"/></mxCell><mxCell id="c7" value="Worked out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1127" y="22" width="90" height="24" as="geometry"/></mxCell><mxCell id="c8" value="Safety rule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1225" y="22" width="96" height="24" as="geometry"/></mxCell><mxCell id="c9" value="Result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1329" y="22" width="62" height="24" as="geometry"/></mxCell><mxCell id="c10" value="On the page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1399" y="22" width="96" height="24" as="geometry"/></mxCell><mxCell id="c11" value="By a click" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1503" y="22" width="90" height="24" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="1620" height="112" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;1. When&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="94" width="136" height="24" as="geometry"/></mxCell><mxCell id="c14" value="One background reader" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="118" width="136" height="72" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Once a day, and at start&lt;/b&gt;&lt;br&gt;The whole read runs every 24 hours and when the app starts. It takes a few minutes. The page shows the last read until the new one is done." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="98" width="346" height="84" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;When Aternity does not answer&lt;/b&gt;&lt;br&gt;Nothing is saved (it would empty the day&#x27;s flags). The last good read stays on the page and the read is tried again every 15 minutes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="98" width="346" height="84" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;What is kept&lt;/b&gt;&lt;br&gt;Each day&#x27;s counts and names are saved for 90 days: programs, versions, flags. They give each flag its history and the word &quot;new&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="98" width="346" height="84" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;A reply cut short&lt;/b&gt;&lt;br&gt;Counts from a reply that was cut short are marked partial on the page. A read Aternity refuses as too long is asked once more with its own $fetch_all_rows=yes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="98" width="346" height="84" as="geometry"/></mxCell><mxCell id="c19" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="196" as="sourcePoint"/><mxPoint x="830" y="222" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="222" width="1620" height="157" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;2. Read&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="232" width="136" height="24" as="geometry"/></mxCell><mxCell id="c22" value="From Aternity only" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="256" width="136" height="117" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Installed software list&lt;/b&gt;&lt;br&gt;Aternity adds it up for us:&lt;br&gt;· PCs per program and version&lt;br&gt;· PCs per program&lt;br&gt;· PCs with a program installed for one user only&lt;br&gt;· the names of the PCs in the list&lt;br&gt;· Windows updates on each PC (type &quot;OS Update&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="236" width="346" height="129" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Device list&lt;/b&gt;&lt;br&gt;One row per PC Aternity still knows:&lt;br&gt;· the PC&#x27;s name&lt;br&gt;· its Windows version&lt;br&gt;· when Windows was last updated&lt;br&gt;Aternity takes a PC off this list about a month after it last heard from it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="236" width="346" height="129" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;App usage (14 days, day by day) and actions (7 days)&lt;/b&gt;&lt;br&gt;Per application, version and PC:&lt;br&gt;· PCs that ran it&lt;br&gt;· PCs with a crash&lt;br&gt;· PCs with hang time&lt;br&gt;· actions, and those Aternity rated Major" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="236" width="346" height="129" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Crash events, last 7 days&lt;/b&gt;&lt;br&gt;Every crash by application, program file and version.&lt;br&gt;Used to answer questions about a program Aternity lists under another name (&quot;Edge&quot;)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="236" width="346" height="129" as="geometry"/></mxCell><mxCell id="c27" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="379" as="sourcePoint"/><mxPoint x="830" y="405" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="405" width="1620" height="541" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;3. Worked out&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="415" width="136" height="24" as="geometry"/></mxCell><mxCell id="c30" value="In this order, A to G" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="439" width="136" height="501" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;A. PCs that are gone are left out&lt;/b&gt;&lt;br&gt;Uses: installed list + device list.&lt;br&gt;A PC in the installed list but not in the device list is gone: Aternity dropped the PC and kept its software. Their software is read (25 PCs a read) and taken off Aternity&#x27;s totals: each PC once per program and version, per program, per one-user program. A program only those PCs have disappears." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="419" width="468" height="114" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;B. 2+ versions on one PC&lt;/b&gt;&lt;br&gt;Uses: installed list.&lt;br&gt;A program with more installs than PCs has a PC counted twice. Each such program (the 200 with the most extra installs) is read PC by PC: PCs with 2 or more versions, and which versions go together." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="676" y="419" width="468" height="114" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;C. Behind most PCs&lt;/b&gt;&lt;br&gt;Uses: installed list.&lt;br&gt;For each program whose versions are all numbers: the version on the most PCs is the reference. A PC on an older version is &quot;behind&quot;. A PC with 2 versions counts once, and only when every version on it is older." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1162" y="419" width="468" height="114" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;D. Windows updates per Windows version&lt;/b&gt;&lt;br&gt;Uses: device list + installed list.&lt;br&gt;PCs are grouped by Windows version. An update is counted only on its own Windows version&#x27;s PCs. It is &quot;missing&quot; when more than 50% of those PCs have it and at least 5 do not. For the PCs without it: what they have instead (a later update may replace it)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="551" width="711" height="204" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;E. Does one version have more problems?&lt;/b&gt;&lt;br&gt;Uses: app usage (day by day) and actions. Virtual desktops and physical PCs are looked at apart.&lt;br&gt;1. Before and after an update: PCs whose version changed once in 14 days, for each PC as many days after as before; the PCs with a crash (or hang time) after against those before.&lt;br&gt;2. Each version against the version most PCs have (20+ PCs on each side; a version new this week is left to 1).&lt;br&gt;Raised: 2 times the other side&#x27;s share, 5+ PCs with the problem, and still so with 2 more PCs with it on the other side (5 more actions rated Major for slow actions).&lt;br&gt;The same PCs decide: a version that is worse than another in 2 is raised only when the PCs that ran both versions show it too (when 5+ of them had the problem on one of the two, they must pass the same checks). Two versions side by side are different PCs.&lt;br&gt;One version that Aternity writes in two ways (3.0.20 and 3.0.20.0) is counted as one version. A move to a lower version is a &quot;change of version&quot;, not an update." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="919" y="551" width="711" height="204" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;F. Installed for one user only&lt;/b&gt;&lt;br&gt;Uses: installed list.&lt;br&gt;Aternity marks every install with who it is for: the whole PC (&quot;ALL&quot;) or one person (&quot;Specific User&quot;). An install for one person sits in that person&#x27;s own Windows profile, not in Program Files: usually something the person installed themselves, with no admin rights, and often not rolled out by IT (examples: Zoom, a browser&#x27;s per-user copy, a chat app).&lt;br&gt;Counted: for each program, the PCs that have it installed this way, next to all its PCs.&lt;br&gt;Why it is raised: such a copy is outside the usual roll-out and patching, another person on the same PC does not have it, and one PC can carry several copies, one per person." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="773" width="711" height="159" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;G. Rare programs&lt;/b&gt;&lt;br&gt;Uses: installed list.&lt;br&gt;Programs on 5 PCs or fewer, grouped by how many PCs have them (1, 2-5, 6-20, ...). Windows updates are not counted as programs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="919" y="773" width="711" height="159" as="geometry"/></mxCell><mxCell id="c38" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="954" width="1620" height="127" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Safety rules&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="964" width="136" height="24" as="geometry"/></mxCell><mxCell id="c40" value="They guard the steps above" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="988" width="136" height="87" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;When A cannot be done&lt;/b&gt;&lt;br&gt;Nothing is left out and a note on the page says so, when: the device list is not read whole; the gone PCs&#x27; software is not read whole; or more than 50% of the PCs are missing from the device list (then the two lists do not match)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="968" width="468" height="99" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Cut-short Windows updates&lt;/b&gt;&lt;br&gt;PCs past the cut would look as if they had no update. The Windows flag then says its counts are partial." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="676" y="968" width="468" height="99" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;An app whose every PC failed&lt;/b&gt;&lt;br&gt;It has no other version to compare with, so it is never raised. It is shown, with the PCs that failed, but not as a red flag." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1162" y="968" width="468" height="99" as="geometry"/></mxCell><mxCell id="c44" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1081" as="sourcePoint"/><mxPoint x="830" y="1107" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="1107" width="1620" height="331" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;4. Red flags&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="1117" width="136" height="24" as="geometry"/></mxCell><mxCell id="c47" value="One line per kind, most PCs first" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="1141" width="136" height="291" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Crashes more&lt;/b&gt;&lt;br&gt;From E. One line per raised version:&lt;br&gt;&quot;it crashed on N% of its PCs (n of m); on the version most have: ...&quot;, with the counts of the PCs that ran both versions, or &quot;more crashes after the update&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="1121" width="346" height="99" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Stops responding more&lt;/b&gt;&lt;br&gt;From E. One line per raised version:&lt;br&gt;The same, for PCs where it stopped responding." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="1121" width="346" height="99" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Slower&lt;/b&gt;&lt;br&gt;From E. One line per raised version:&lt;br&gt;&quot;N% of its actions were rated Major (n of m, on P PCs)&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="1121" width="346" height="99" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Windows update not on every PC&lt;/b&gt;&lt;br&gt;From D. One line: how many updates are missing somewhere, and the one missing on the most PCs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="1121" width="346" height="99" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;2+ versions on one PC&lt;/b&gt;&lt;br&gt;From B. One line: how many programs, PCs in all, and the program with the most." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="1238" width="346" height="84" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;Behind most PCs&lt;/b&gt;&lt;br&gt;From C. Programs with 5+ PCs behind. One line, naming the one with the most." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="1238" width="346" height="84" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;Installed for one user&lt;/b&gt;&lt;br&gt;From F. One line: how many programs are installed that way, how many installs, and the program on the most PCs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="1238" width="346" height="84" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;On 5 PCs or fewer&lt;/b&gt;&lt;br&gt;From G. One line: how many of the programs are that rare." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="1238" width="346" height="84" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;Ranked&lt;/b&gt;&lt;br&gt;By PCs, most first. Equal: crashes, stops responding, slower, then Windows, 2+ versions, behind, one user, rare." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="1340" width="346" height="84" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;New&lt;/b&gt;&lt;br&gt;A flag is &quot;new&quot; when the latest day before that had any flag did not have it. A day saved empty does not make every flag new." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="1340" width="346" height="84" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;Bars&lt;/b&gt;&lt;br&gt;Each flag&#x27;s PCs per day, from the saved days." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="1340" width="346" height="84" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;Never a flag&lt;/b&gt;&lt;br&gt;A count our code worked out as a share or ratio; an application split by another program&#x27;s version (it can differ by chance)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="1340" width="346" height="84" as="geometry"/></mxCell><mxCell id="c60" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1438" as="sourcePoint"/><mxPoint x="830" y="1464" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c61" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="1464" width="1620" height="229" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;5. On the page&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="1474" width="136" height="24" as="geometry"/></mxCell><mxCell id="c63" value="The Software tab" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="1498" width="136" height="189" as="geometry"/></mxCell><mxCell id="c64" value="&lt;b&gt;Tiles&lt;/b&gt;&lt;br&gt;PCs in the list (and how many more were left out as gone), programs, installs (and those for one user), red flags." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="1478" width="468" height="69" as="geometry"/></mxCell><mxCell id="c65" value="&lt;b&gt;Red flags&lt;/b&gt;&lt;br&gt;The list from 4. A click on a line opens its section or the PCs behind it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="676" y="1478" width="468" height="69" as="geometry"/></mxCell><mxCell id="c66" value="&lt;b&gt;Summary for management&lt;/b&gt;&lt;br&gt;The AI words up to 5 sentences from the top flags. Every number must be one of the flags&#x27; own; otherwise our own sentence is shown." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1162" y="1478" width="468" height="69" as="geometry"/></mxCell><mxCell id="c67" value="&lt;b&gt;Application health by version&lt;/b&gt;&lt;br&gt;Virtual desktops and physical PCs by a switch. Per application: version by version first, then before and after each update. One red flag is one line in the list, one ▲ on the count that line quotes and one on its button; a second raised count of the same version and problem says it is counted with it. No box of sentences above the tables. A version not raised because of the PCs that ran both says so on its count. A table with a percentage beside each count." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="1565" width="711" height="114" as="geometry"/></mxCell><mxCell id="c68" value="&lt;b&gt;Other sections&lt;/b&gt;&lt;br&gt;Compare versions · Behind most PCs · 2+ versions on one PC · Installed for one user · Windows · rare programs. Every table has a percentage beside each count." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="919" y="1565" width="711" height="114" as="geometry"/></mxCell><mxCell id="c69" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1693" as="sourcePoint"/><mxPoint x="830" y="1719" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c70" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="1719" width="1620" height="157" as="geometry"/></mxCell><mxCell id="c71" value="&lt;b&gt;6. By a click&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="1729" width="136" height="24" as="geometry"/></mxCell><mxCell id="c72" value="Read now. Names of PCs and users appear only here" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="1753" width="136" height="117" as="geometry"/></mxCell><mxCell id="c73" value="&lt;b&gt;PCs with a program&lt;/b&gt;&lt;br&gt;The PCs with a program, or one version of it, each with its versions. PCs that are gone are left out, as in the counts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="1733" width="346" height="129" as="geometry"/></mxCell><mxCell id="c74" value="&lt;b&gt;PCs with a problem&lt;/b&gt;&lt;br&gt;The PCs with a crash, hang time or Major actions on one version in the last 7 days: user, days, the last time. &quot;Investigate&quot; runs an investigation. After an update: the PCs of that change of version only. When the list counts other than the tab&#x27;s daily read did, it says both." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="1733" width="346" height="129" as="geometry"/></mxCell><mxCell id="c75" value="&lt;b&gt;Compare and before / after&lt;/b&gt;&lt;br&gt;Two versions side by side on every kind of issue. Or the same PCs before and after their update (14 days read). Both count as the tab&#x27;s own tables do: the kind of PC on screen, for each PC as many days after as before." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="1733" width="346" height="129" as="geometry"/></mxCell><mxCell id="c76" value="&lt;b&gt;PCs without a Windows update&lt;/b&gt;&lt;br&gt;The PCs of that Windows version without the update, with what each has instead. Same names as the daily read, so the total matches the flag." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="1733" width="346" height="129" as="geometry"/></mxCell><mxCell id="c77" value="Ask anything uses the same look-ups for questions about software. The numbers are the code&#x27;s own settings on the day the drawing was made. Names of PCs and users are never in a saved count unless said." style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="1884" width="1620" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>