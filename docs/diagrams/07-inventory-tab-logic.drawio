<mxfile host="drawio"><diagram name="07-inventory-tab-logic" id="07-inventory-tab-logic"><mxGraphModel dx="1660" dy="1134" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1134" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Inventory tab: every rule behind it&lt;/b&gt;" style="text;html=1;fontSize=20;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="860" height="34" as="geometry"/></mxCell><mxCell id="c4" value="What Aternity knows about each PC, the PCs that need a look, and how many PCs are in use. Read top to bottom." style="text;html=1;fontSize=12;fontColor=#5d6676;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c5" value="Timing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1000" y="22" width="62" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1070" y="22" width="49" height="24" as="geometry"/></mxCell><mxCell id="c7" value="Worked out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1127" y="22" width="90" height="24" as="geometry"/></mxCell><mxCell id="c8" value="Safety rule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1225" y="22" width="96" height="24" as="geometry"/></mxCell><mxCell id="c9" value="Result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1329" y="22" width="62" height="24" as="geometry"/></mxCell><mxCell id="c10" value="On the page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1399" y="22" width="96" height="24" as="geometry"/></mxCell><mxCell id="c11" value="By a click" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1503" y="22" width="90" height="24" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="1620" height="127" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;1. When&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="94" width="136" height="24" as="geometry"/></mxCell><mxCell id="c14" value="One background reader" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="118" width="136" height="87" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;The device list&lt;/b&gt;&lt;br&gt;Read every 60 minutes. When Aternity does not answer: again after 15 minutes, and the last read stays on the page. Which columns Aternity publishes is asked again every 24 hours." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="98" width="346" height="99" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;PCs in use&lt;/b&gt;&lt;br&gt;After each read of the list: the finished days not kept yet, a day at a time. A day is read again until it is 2 days old, then kept for good. The first read takes every day Aternity keeps (about 90 small reads, once)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="98" width="346" height="99" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;What is held in memory only&lt;/b&gt;&lt;br&gt;The device list itself: PC names, last users, serial numbers. Nothing of it is written to disk." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="98" width="346" height="99" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;What is kept&lt;/b&gt;&lt;br&gt;Only the usage charts&#x27; counts, per kind of device: days 400 days, months 24 months. No PC or user name." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="98" width="346" height="99" as="geometry"/></mxCell><mxCell id="c19" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="211" as="sourcePoint"/><mxPoint x="830" y="237" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="237" width="1620" height="142" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;2. Read&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="247" width="136" height="24" as="geometry"/></mxCell><mxCell id="c22" value="From Aternity only" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="271" width="136" height="102" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Device list&lt;/b&gt;&lt;br&gt;One row per PC, its latest: every column Aternity publishes of those the tab can show (kind of device, model, serial number, memory, system disk, last start-up, agent version and status, stability index, last user, department, location, when it was last heard from)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="251" width="346" height="114" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;App usage, last 8 days&lt;/b&gt;&lt;br&gt;Which PCs ran an application, each PC once. For &quot;not used&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="251" width="346" height="114" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;App usage, day by day&lt;/b&gt;&lt;br&gt;For each finished day: the PCs with a row of that day (a row counts only when its own time is of that day). Aternity has no row for today until the day is over." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="251" width="346" height="114" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;App usage, a month&lt;/b&gt;&lt;br&gt;One read asking for the PC only, so Aternity adds the month&#x27;s days up: a row per PC used at least once. Only while Aternity keeps the month whole." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="251" width="346" height="114" as="geometry"/></mxCell><mxCell id="c27" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="379" as="sourcePoint"/><mxPoint x="830" y="405" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="405" width="1620" height="259" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;3. Worked out&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="415" width="136" height="24" as="geometry"/></mxCell><mxCell id="c30" value="A to F" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="439" width="136" height="219" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;A. Tiles&lt;/b&gt;&lt;br&gt;PCs in the list, by Aternity&#x27;s own kind of device. Heard from in the last 7 days. Retired (the Software tab&#x27;s count: software still in Aternity, PC no longer in its list). Things to look at." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="419" width="468" height="129" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;B. Needs a look: 8 lines&lt;/b&gt;&lt;br&gt;An agent older than the version most PCs have · not used in 8 days · not restarted in over 14 days · not heard from in 8 days or more · agent stopped · stability index under 5 · little free space (Aternity&#x27;s bands that end at 10 GB or under) · a spinning hard disk.&lt;br&gt;Each line: its PCs, and the PCs it is counted among (a count with its share)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="676" y="419" width="468" height="129" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;C. Last heard from&lt;/b&gt;&lt;br&gt;PCs by when Aternity last heard from them: today, 1 to 7 days, 8 to 30 days, 31 or more, no date. And the agent&#x27;s status in Aternity&#x27;s own words." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1162" y="419" width="468" height="129" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;D. In use each day&lt;/b&gt;&lt;br&gt;The PCs an application ran on, per kind of device, against the PCs of that kind in the list at that read. The last 30 finished days; yesterday is the last bar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="566" width="468" height="84" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;E. In use each month&lt;/b&gt;&lt;br&gt;PCs used at least once in the month, counted by Aternity itself; the busiest day of the month from the days kept. Up to 12 months, growing as the tab keeps each month. This month is &quot;so far&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="676" y="566" width="468" height="84" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;F. Four figures&lt;/b&gt;&lt;br&gt;A typical working day and a typical weekend day (the middle value of the days shown), the busiest day, this month so far. Each a count with its share of the list." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1162" y="566" width="468" height="84" as="geometry"/></mxCell><mxCell id="c37" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="672" width="1620" height="127" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Safety rules&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="682" width="136" height="24" as="geometry"/></mxCell><mxCell id="c39" value="They guard the counts above" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="706" width="136" height="87" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Not judged is not 0&lt;/b&gt;&lt;br&gt;A line whose column this Aternity does not publish, or &quot;not used&quot; when app usage could not be read, says &quot;not judged&quot; and why." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="686" width="346" height="99" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;No row is a gap&lt;/b&gt;&lt;br&gt;A day Aternity has no row for is a gap on the chart, never 0. A day that could not be read, or was cut short, is said and tried again; 3 failed days in a row end a pass." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="686" width="346" height="99" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Only PCs in the list count&lt;/b&gt;&lt;br&gt;A PC with usage that is not in the device list is counted apart and said on its bar, so a share is never over 100%." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="686" width="346" height="99" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;What cannot be counted is not&lt;/b&gt;&lt;br&gt;A month Aternity no longer keeps whole is never counted. A saved file that cannot be read is set aside, not written over." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="686" width="346" height="99" as="geometry"/></mxCell><mxCell id="c44" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="799" as="sourcePoint"/><mxPoint x="830" y="825" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="825" width="1620" height="127" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;4. On the page&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="835" width="136" height="24" as="geometry"/></mxCell><mxCell id="c47" value="The Inventory tab, top to bottom" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="859" width="136" height="87" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Tiles and Desktop usage&lt;/b&gt;&lt;br&gt;The tiles, then two charts: bars for the PCs in use, a line for the PCs in the list (100%). A switch between all PCs and each kind of device; the four figures under them." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="839" width="346" height="99" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Needs a look&lt;/b&gt;&lt;br&gt;The lines, most PCs first. Lines with no PC are named in one sentence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="839" width="346" height="99" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Last heard from · Retired PCs&lt;/b&gt;&lt;br&gt;By age, with the agent&#x27;s status. Retired PCs, and PCs in the list that nobody uses." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="839" width="346" height="99" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Find a PC&lt;/b&gt;&lt;br&gt;By part of a PC name, a person or a serial number." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="839" width="346" height="99" as="geometry"/></mxCell><mxCell id="c52" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="952" as="sourcePoint"/><mxPoint x="830" y="978" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="978" width="1620" height="112" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;5. By a click&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="988" width="136" height="24" as="geometry"/></mxCell><mxCell id="c55" value="Names of PCs and users appear only here" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="1012" width="136" height="72" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;A line&#x27;s PCs&lt;/b&gt;&lt;br&gt;Up to 200, each with its own value for that line, &quot;Investigate&quot; and its card. From the read held: no extra read of Aternity." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="992" width="346" height="84" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;Find a PC&lt;/b&gt;&lt;br&gt;From 2 characters: up to 20 PCs whose name, last user or serial number has them." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="992" width="346" height="84" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;A PC&#x27;s card&lt;/b&gt;&lt;br&gt;Everything Aternity fills for it, the lines it is on, &quot;Investigate&quot;, &quot;Its start-ups&quot;, and &quot;Its software&quot;: the one read of Aternity made at a click." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="992" width="346" height="84" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;Explain · link&lt;/b&gt;&lt;br&gt;&quot;Explain&quot; on each panel, with the tab&#x27;s own meanings. #inventory opens this tab." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="992" width="346" height="84" as="geometry"/></mxCell><mxCell id="c60" value="No Active Directory on this tab: the main page has no login, and AD look-ups there stay with the Care list. The numbers are the code&#x27;s own settings on the day the drawing was made. Names of PCs and users are never in a saved count unless said." style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="1098" width="1620" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>