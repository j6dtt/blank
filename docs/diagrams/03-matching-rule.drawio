gt;PC&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8b5cf6;strokeColor=#8b5cf6;fontSize=11;fontColor=#ffffff;align=center;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;arcSize=50;" vertex="1" parent="1"><mxGeometry x="40" y="322" width="64" height="20" as="geometry"/></mxCell><mxCell id="c30" value="11:30  Disk queue 6 (limit 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="116" y="316" width="380" height="32" as="geometry"/></mxCell><mxCell id="c31" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="496" y="332" as="sourcePoint"/><mxPoint x="556" y="332" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="Doesn&#x27;t count: 48 min later" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;fontSize=12;fontColor=#b71c1c;align=left;verticalAlign=middle;arcSize=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="316" width="340" height="32" as="geometry"/></mxCell><mxCell id="c33" value="Each problem gets a count: &lt;b&gt;at N of M slow actions&lt;/b&gt;.&lt;br&gt;&lt;br&gt;The one at the most slow actions is the answer: &lt;b&gt;Likely&lt;/b&gt; if more than half, &lt;b&gt;Possibly&lt;/b&gt; if fewer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=11;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=6;spacingLeft=6;spacingRight=6;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="920" y="140" width="160" height="208" as="geometry"/></mxCell><mxCell id="c34" value="A crash, hang or health event of one application counts only for that application&#x27;s slow actions. CPU, memory, disk, network and server problems count for every app. Values are examples." 