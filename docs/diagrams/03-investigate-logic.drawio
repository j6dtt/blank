<mxfile host="drawio"><diagram name="03-investigate-logic" id="03-investigate-logic"><mxGraphModel dx="1660" dy="1089" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1089" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Investigate tab: every rule behind it&lt;/b&gt;" style="text;html=1;fontSize=20;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="860" height="34" as="geometry"/></mxCell><mxCell id="c4" value="Why was this user slow, or what went wrong for them? Plain counts, no scores. Read top to bottom." style="text;html=1;fontSize=12;fontColor=#5d6676;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c5" value="Timing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1000" y="22" width="62" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1070" y="22" width="49" height="24" as="geometry"/></mxCell><mxCell id="c7" value="Worked out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1127" y="22" width="90" height="24" as="geometry"/></mxCell><mxCell id="c8" value="Safety rule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1225" y="22" width="96" height="24" as="geometry"/></mxCell><mxCell id="c9" value="Result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1329" y="22" width="62" height="24" as="geometry"/></mxCell><mxCell id="c10" value="On the page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1399" y="22" width="96" height="24" as="geometry"/></mxCell><mxCell id="c11" value="By a click" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1503" y="22" width="90" height="24" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="1620" height="112" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;1. When&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="94" width="136" height="24" as="geometry"/></mxCell><mxCell id="c14" value="Only when asked" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="118" width="136" height="72" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;How it starts&lt;/b&gt;&lt;br&gt;The Investigate button, any &quot;Investigate&quot; link on the other tabs, Ask anything, or the Care list by itself." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="98" width="346" height="84" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;How it runs&lt;/b&gt;&lt;br&gt;As a job in the background; the page asks for it every second. A finished one is kept 10 minutes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="98" width="346" height="84" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;What it covers&lt;/b&gt;&lt;br&gt;One user (or PC) and a window of time. Up to 8 of the user&#x27;s PCs: those with a slow action first, then the most used." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="98" width="346" height="84" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Nothing is saved&lt;/b&gt;&lt;br&gt;Except the Care list&#x27;s own latest investigation per user." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="98" width="346" height="84" as="geometry"/></mxCell><mxCell id="c19" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="196" as="sourcePoint"/><mxPoint x="830" y="222" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="222" width="1620" height="112" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;2. Read&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="232" width="136" height="24" as="geometry"/></mxCell><mxCell id="c22" value="From Aternity and NetIM" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="256" width="136" height="72" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;The user&#x27;s actions&lt;/b&gt;&lt;br&gt;Each action with its time, application, Aternity&#x27;s rating, and the PC&#x27;s CPU, memory, disk queue and network round trip at that action." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="236" width="346" height="84" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;What happened on the PC&lt;/b&gt;&lt;br&gt;Health events, application crashes and hang time, start-ups and their parts, the busiest programs (per hour), the software change log (14 days)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="236" width="346" height="84" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;For comparison&lt;/b&gt;&lt;br&gt;The user&#x27;s own last 30 days (Aternity keeps about 8), other users of the same applications, the same hours on the 7 days before, other PCs with the same failure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="236" width="346" height="84" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;NetIM&lt;/b&gt;&lt;br&gt;The network devices and servers behind the PC and the application: their values over limits and their alerts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="236" width="346" height="84" as="geometry"/></mxCell><mxCell id="c27" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="334" as="sourcePoint"/><mxPoint x="830" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="360" width="1620" height="304" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;3. Worked out&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="370" width="136" height="24" as="geometry"/></mxCell><mxCell id="c30" value="A to H" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="394" width="136" height="264" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;A. Which actions were slow&lt;/b&gt;&lt;br&gt;Aternity&#x27;s own rating decides. Only when no rating is set to count as slow: an action over the response time in config.yaml." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="374" width="346" height="129" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;B. Problems collected&lt;/b&gt;&lt;br&gt;PC values over their limits, a failing disk, health events, crashes and hangs, a start-up with a slow action in it or just after, NetIM values and alerts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="374" width="346" height="129" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;C. Which problem counts for which slow action&lt;/b&gt;&lt;br&gt;A problem counts for the slow actions within 5 minutes of it (bucket_minutes). A PC reading counts only for its own action. A crash or hang of an application counts only for that application. Never across PCs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="374" width="346" height="129" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;D. Why, for each issue&lt;/b&gt;&lt;br&gt;Where the application failed (part, module, version, error). How many other PCs fail the same way, of how many using it, and since when. A software change is a possible cause only with the same name or version as the failing part, before it, and with no other PC failing on another version." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="374" width="346" height="129" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;E. Compared with normal&lt;/b&gt;&lt;br&gt;Each slow application and activity against the user&#x27;s own earlier runs (5 needed) and other users at the same time. &quot;Became slow&quot; needs 2 slow runs and most runs slow since." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="521" width="346" height="129" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;F. Other users&lt;/b&gt;&lt;br&gt;Other users of the same applications in the slow minutes, grouped by the network point they sit behind (from NetIM), against the same hours on the days before. &quot;Unusual&quot;: more slow than on any of those days. A common point: an unusual group with more than half the slow users." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="521" width="346" height="129" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;G. Right after a start-up&lt;/b&gt;&lt;br&gt;A slow action up to 10 minutes after a start-up, against the same activity on all PCs of its kind in the 24 hours before. &quot;Slower then&quot;: 1.25 times, with 20 runs on each side." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="521" width="346" height="129" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;H. The headline&lt;/b&gt;&lt;br&gt;The most serious thing leads: a failing disk, a crash, a hang, then slow actions. For slow actions the first that fits: a problem at them; other users slow at once; became slow after a change; became slow, no change; right after a start-up; always slow; others as usual; nothing found." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="521" width="346" height="129" as="geometry"/></mxCell><mxCell id="c39" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="672" width="1620" height="112" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Safety rules&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="682" width="136" height="24" as="geometry"/></mxCell><mxCell id="c41" value="They guard the answer above" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="706" width="136" height="72" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;A failed read is never &quot;nothing found&quot;&lt;/b&gt;&lt;br&gt;It becomes &quot;not known&quot;, &quot;at least N&quot;, &quot;not checked&quot; or &quot;not read in full&quot;, and is listed under Warnings." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="686" width="346" height="84" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;One source down does not stop it&lt;/b&gt;&lt;br&gt;A failing NetIM call or an optional Aternity source is a warning; the investigation goes on with the rest." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="686" width="346" height="84" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;No guessed cause&lt;/b&gt;&lt;br&gt;A program is named only when its hourly CPU is at least half the PC&#x27;s reading. Windows&#x27; own modules are never blamed. A change logged after the failure is said so." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="686" width="346" height="84" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Left out is said&lt;/b&gt;&lt;br&gt;PCs beyond the limit, problems beyond 25 explained, and anything cut short are named." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="686" width="346" height="84" as="geometry"/></mxCell><mxCell id="c46" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="784" as="sourcePoint"/><mxPoint x="830" y="810" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="810" width="1620" height="112" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;4. On the page&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="820" width="136" height="24" as="geometry"/></mxCell><mxCell id="c49" value="The answer, then the detail" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="844" width="136" height="72" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;The answer&lt;/b&gt;&lt;br&gt;A title in two sentences: what the user felt, then one verdict. Then the reason and &quot;Also slow&quot; lines." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="824" width="346" height="84" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Sections&lt;/b&gt;&lt;br&gt;What the user felt · Other users of these apps · What went wrong (one row per issue) · What changed · What to do · What was checked." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="824" width="346" height="84" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;One timeline, one list&lt;/b&gt;&lt;br&gt;Every slow action and problem on one timeline and in one problems list. No second view repeats them." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="824" width="346" height="84" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;Warnings&lt;/b&gt;&lt;br&gt;Every read that failed or was cut short, in plain words." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="824" width="346" height="84" as="geometry"/></mxCell><mxCell id="c54" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="922" as="sourcePoint"/><mxPoint x="830" y="948" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c55" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="948" width="1620" height="97" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;5. By a click&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="958" width="136" height="24" as="geometry"/></mxCell><mxCell id="c57" value="" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="982" width="136" height="57" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;Explain&lt;/b&gt;&lt;br&gt;On every panel: the panel&#x27;s lines worded by the AI, checked against the lines." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="962" width="346" height="69" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;Open in Start-ups&lt;/b&gt;&lt;br&gt;From a start-up in the answer: that tab for the same user or PC." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="962" width="346" height="69" as="geometry"/></mxCell><mxCell id="c60" value="&lt;b&gt;Ask anything&lt;/b&gt;&lt;br&gt;Can run one whole investigation per question and read its report (at most 5 reads of Aternity per question)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="962" width="346" height="69" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;Link&lt;/b&gt;&lt;br&gt;#investigate opens this tab; a result stays while other tabs are used." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="962" width="346" height="69" as="geometry"/></mxCell><mxCell id="c62" value="The numbers are the code&#x27;s own settings on the day the drawing was made. Names of PCs and users are never in a saved count unless said." style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="1053" width="1620" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>