<mxfile host="drawio"><diagram name="06-admin-page-logic" id="06-admin-page-logic"><mxGraphModel dx="1660" dy="1320" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1320" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Admin page: every rule behind it&lt;/b&gt;" style="text;html=1;fontSize=20;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="860" height="34" as="geometry"/></mxCell><mxCell id="c4" value="Four tabs behind a login: Statistics (how the app is used and what it costs Aternity), SecureView, Actions, Code (the app&#x27;s own source, listed and asked about)." style="text;html=1;fontSize=12;fontColor=#5d6676;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c5" value="Timing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1000" y="22" width="62" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1070" y="22" width="49" height="24" as="geometry"/></mxCell><mxCell id="c7" value="Worked out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1127" y="22" width="90" height="24" as="geometry"/></mxCell><mxCell id="c8" value="Safety rule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1225" y="22" width="96" height="24" as="geometry"/></mxCell><mxCell id="c9" value="Result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1329" y="22" width="62" height="24" as="geometry"/></mxCell><mxCell id="c10" value="On the page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1399" y="22" width="96" height="24" as="geometry"/></mxCell><mxCell id="c11" value="By a click" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1503" y="22" width="90" height="24" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="1620" height="112" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;1. When and who&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="94" width="136" height="24" as="geometry"/></mxCell><mxCell id="c14" value="/admin, no link from the main page" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="118" width="136" height="72" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Login&lt;/b&gt;&lt;br&gt;Its own password, over HTTPS only. A login lasts 8 hours; a restart logs out. 5 wrong passwords from one address lock it for 15 minutes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="98" width="346" height="84" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Refresh&lt;/b&gt;&lt;br&gt;Only the open tab is read, every minute. Actions is read only when asked; Code reads its list of files once." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="98" width="346" height="84" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;What is kept&lt;/b&gt;&lt;br&gt;Usage: one file a day, 30 days. SecureView: 400 days. Actions and Code: nothing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="98" width="346" height="84" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Counting&lt;/b&gt;&lt;br&gt;Every call the app makes to Aternity, NetIM, the AI services and AD is counted as it happens, under what the app was doing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="98" width="346" height="84" as="geometry"/></mxCell><mxCell id="c19" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="196" as="sourcePoint"/><mxPoint x="830" y="222" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="222" width="1620" height="127" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;2. Read&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="232" width="136" height="24" as="geometry"/></mxCell><mxCell id="c22" value="" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="256" width="136" height="87" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Visits&lt;/b&gt;&lt;br&gt;The main page reports each tab a visitor opens, with the visitor&#x27;s address. No login there, so no name." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="236" width="273" height="99" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Aternity, by address&lt;/b&gt;&lt;br&gt;The Today reader keeps which user had actions from which address, to put a name to a visit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="481" y="236" width="273" height="99" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Aternity, the device people sit at&lt;/b&gt;&lt;br&gt;For SecureView: each action&#x27;s device name, when it matches the pattern in config.yaml. Before its own records: Aternity&#x27;s hourly, then daily data." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="772" y="236" width="273" height="99" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Active Directory&lt;/b&gt;&lt;br&gt;Read only: a user&#x27;s name and department, a desktop&#x27;s unit; a person found by name." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1063" y="236" width="273" height="99" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;The app&#x27;s own source&lt;/b&gt;&lt;br&gt;For Code: the .py files and the two pages of the app&#x27;s code folder on that host, by the list of them. Nothing else: not config.yaml, .env, certificates or data." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1354" y="236" width="273" height="99" as="geometry"/></mxCell><mxCell id="c28" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="349" as="sourcePoint"/><mxPoint x="830" y="375" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="375" width="1620" height="346" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;3. Worked out&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="385" width="136" height="24" as="geometry"/></mxCell><mxCell id="c31" value="A to I" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="409" width="136" height="306" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;A. Who visited&lt;/b&gt;&lt;br&gt;The user nearest the visit from that address, within 60 minutes. Several at once: &quot;one of N&quot;. None yet: &quot;waiting for Aternity&quot;, then &quot;not known&quot; after 2 hours." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="389" width="468" height="84" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;B. Usage&lt;/b&gt;&lt;br&gt;Per day: people, tabs opened, investigations by where they were started, questions asked and look-ups that failed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="676" y="389" width="468" height="84" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;C. Load&lt;/b&gt;&lt;br&gt;Per system and per purpose: calls, rows, waiting time, retries, failed, cut short. An answer the app expects (an AI service with no model list) is not a failure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1162" y="389" width="468" height="84" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;D. SecureView&lt;/b&gt;&lt;br&gt;Per device and day: first and last heard, hours, people, desktops. A day is complete when every hour was read after it ended. Today against the usual by now (5 complete days of the same kind). History: silent 30 / 60 / 90 days." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="491" width="468" height="99" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;E. SecureView search&lt;/b&gt;&lt;br&gt;Every day kept, by part of a username, device or desktop (2+ characters; 20 matches of each). Nothing found: one search in AD by a person&#x27;s real name." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="676" y="491" width="468" height="99" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;F. Actions&lt;/b&gt;&lt;br&gt;Any user&#x27;s actions of today, one read from local midnight to now, at most 5,000 rows, latest first." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1162" y="491" width="468" height="99" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;G. Code, the files&lt;/b&gt;&lt;br&gt;Each file&#x27;s lines, what it does (its own first sentence) and its parts: settings with their values, functions and classes with their lines, the address a web function serves. No AI." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="608" width="468" height="99" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;H. Code, the chat&lt;/b&gt;&lt;br&gt;The AI looks in the files, up to 8 look-ups a question: search, a file&#x27;s parts, read (160 lines at once), a setting. A follow-up carries the last 6 answers. &quot;Explain these lines&quot; gives it the lines picked with the function around them." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="676" y="608" width="468" height="99" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;I. Code, the answer&lt;/b&gt;&lt;br&gt;The places it names are read from the disk and shown under it (up to 5, 40 lines each). What it looked at is listed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1162" y="608" width="468" height="99" as="geometry"/></mxCell><mxCell id="c41" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="729" width="1620" height="214" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Safety rules&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="739" width="136" height="24" as="geometry"/></mxCell><mxCell id="c43" value="" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="763" width="136" height="174" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Never a guessed name&lt;/b&gt;&lt;br&gt;When 10 or more visits all come from one address (a proxy), the page says people cannot be told apart." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="743" width="346" height="84" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Aternity&#x27;s times never move ours&lt;/b&gt;&lt;br&gt;What SecureView saw itself keeps its minute; Aternity&#x27;s hourly data only widens a day (&quot;08:xx&quot;), its daily data gives no time (&quot;day only&quot;)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="743" width="346" height="84" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Cut short is said&lt;/b&gt;&lt;br&gt;Actions cut at its limit, a reply cut short, a day not read: each is said, never &quot;no action&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="743" width="346" height="84" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;AD&lt;/b&gt;&lt;br&gt;A refused login is never tried again in that run (each try counts towards a lockout). Not answering: a pause before the next try." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="743" width="346" height="84" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Code: only the source&lt;/b&gt;&lt;br&gt;A file is opened by the list only, never from a name that was typed or that the AI sent. A setting is told by its place and default, never its value on that host." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="845" width="346" height="84" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Code: marked, not hidden&lt;/b&gt;&lt;br&gt;A file that is not a source file, a line it did not read, a name in none of its look-ups, a number found nowhere in them: each is marked under the answer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="845" width="346" height="84" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Code: the AI&#x27;s own typing is said&lt;/b&gt;&lt;br&gt;A code block it writes is labelled as its own unless every line is a line of the files. It cannot change or run code." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="845" width="346" height="84" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Code: one question at a time&lt;/b&gt;&lt;br&gt;Read only by a logged-in admin. Its calls to the AI service are on the Load panel as &quot;code chat&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="845" width="346" height="84" as="geometry"/></mxCell><mxCell id="c52" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="943" as="sourcePoint"/><mxPoint x="830" y="969" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="969" width="1620" height="112" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;4. On the page&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="979" width="136" height="24" as="geometry"/></mxCell><mxCell id="c55" value="Four folder tabs" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="1003" width="136" height="72" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;STATISTICS&lt;/b&gt;&lt;br&gt;People using the app now and per day, what they open, investigations, questions, and the Load panel per system with its hours." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="983" width="346" height="84" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;SECUREVIEW&lt;/b&gt;&lt;br&gt;Today (devices heard, by hour, by department), History (every device, silent ones), Search." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="983" width="346" height="84" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;ACTIONS&lt;/b&gt;&lt;br&gt;One user&#x27;s actions today: time to the second, application, activity, response time, rating, desktop, device sat at." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="983" width="346" height="84" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;CODE&lt;/b&gt;&lt;br&gt;Ask (the chat, with the code under each answer) and Files (every file, its parts and its code, a search of every line)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="983" width="346" height="84" as="geometry"/></mxCell><mxCell id="c60" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1081" as="sourcePoint"/><mxPoint x="830" y="1107" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c61" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="1107" width="1620" height="169" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;5. By a click&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="1117" width="136" height="24" as="geometry"/></mxCell><mxCell id="c63" value="" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="1141" width="136" height="129" as="geometry"/></mxCell><mxCell id="c64" value="&lt;b&gt;A department&lt;/b&gt;&lt;br&gt;Lists its devices; again for every department." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="1121" width="468" height="54" as="geometry"/></mxCell><mxCell id="c65" value="&lt;b&gt;A username&lt;/b&gt;&lt;br&gt;Opens Search with it; &quot;All actions today&quot; opens Actions for that person." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="676" y="1121" width="468" height="54" as="geometry"/></mxCell><mxCell id="c66" value="&lt;b&gt;CSV&lt;/b&gt;&lt;br&gt;Search results and Actions can be saved as a file." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1162" y="1121" width="468" height="54" as="geometry"/></mxCell><mxCell id="c67" value="&lt;b&gt;A place in an answer&lt;/b&gt;&lt;br&gt;&quot;web.py:952-989&quot; opens those lines in Files." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="1193" width="468" height="69" as="geometry"/></mxCell><mxCell id="c68" value="&lt;b&gt;A part, a line number, a drag&lt;/b&gt;&lt;br&gt;Picks lines in a file; &quot;Explain these lines&quot; asks at once, &quot;Ask about them&quot; takes them to the chat for your own question." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="676" y="1193" width="468" height="69" as="geometry"/></mxCell><mxCell id="c69" value="&lt;b&gt;A file&lt;/b&gt;&lt;br&gt;Opens its parts and its code; &quot;Explain this file&quot; asks what it does." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1162" y="1193" width="468" height="69" as="geometry"/></mxCell><mxCell id="c70" value="The numbers are the code&#x27;s own settings on the day the drawing was made. Names of PCs and users are never in a saved count unless said." style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="1284" width="1620" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>