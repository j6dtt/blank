<mxfile host="drawio"><diagram name="02-care-list-logic" id="02-care-list-logic"><mxGraphModel dx="1660" dy="1059" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1059" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Care list tab: every rule behind it&lt;/b&gt;" style="text;html=1;fontSize=20;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="860" height="34" as="geometry"/></mxCell><mxCell id="c4" value="A short list of people watched one by one: is something wrong for them right now? Read top to bottom." style="text;html=1;fontSize=12;fontColor=#5d6676;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c5" value="Timing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1000" y="22" width="62" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1070" y="22" width="49" height="24" as="geometry"/></mxCell><mxCell id="c7" value="Worked out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1127" y="22" width="90" height="24" as="geometry"/></mxCell><mxCell id="c8" value="Safety rule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1225" y="22" width="96" height="24" as="geometry"/></mxCell><mxCell id="c9" value="Result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1329" y="22" width="62" height="24" as="geometry"/></mxCell><mxCell id="c10" value="On the page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1399" y="22" width="96" height="24" as="geometry"/></mxCell><mxCell id="c11" value="By a click" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1503" y="22" width="90" height="24" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="1620" height="112" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;1. When&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="94" width="136" height="24" as="geometry"/></mxCell><mxCell id="c14" value="After each read of the Today reader" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="118" width="136" height="72" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Every read&lt;/b&gt;&lt;br&gt;Each user on the list (at most 50) is checked after every read of the Today reader, from rows it already holds. The list file is read again at every check." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="98" width="346" height="84" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Once a day&lt;/b&gt;&lt;br&gt;Each user&#x27;s own 8 days of activity (for their usual) and their 30 days of start-ups are read once a day." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="98" width="346" height="84" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Investigations&lt;/b&gt;&lt;br&gt;One at a time, at most one per user in 60 minutes, queued by the tab itself." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="98" width="346" height="84" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;What is kept&lt;/b&gt;&lt;br&gt;Each user&#x27;s issues and latest investigation, 8 days (usernames on disk, agreed). The list itself is a file changed from the page." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8a94a6;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="98" width="346" height="84" as="geometry"/></mxCell><mxCell id="c19" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="196" as="sourcePoint"/><mxPoint x="830" y="222" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="222" width="1620" height="112" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;2. Read&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="232" width="136" height="24" as="geometry"/></mxCell><mxCell id="c22" value="From Aternity, and names from AD" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="256" width="136" height="72" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Their actions today&lt;/b&gt;&lt;br&gt;From the Today reader: every action rated Major, with its time, application, activity and PC." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="236" width="346" height="84" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Their health events&lt;/b&gt;&lt;br&gt;Events of severity Critical or Major recorded with their username today, and whether one is a failing disk." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="236" width="346" height="84" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Their start-ups&lt;/b&gt;&lt;br&gt;Today&#x27;s, one read per check for the whole list (25 usernames a read). Everyone&#x27;s start-ups today come from the Today tab&#x27;s read." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="236" width="346" height="84" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Active Directory&lt;/b&gt;&lt;br&gt;Each user&#x27;s name, department and whether the account is disabled; asked after the tiles are drawn." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f0fb;strokeColor=#1e6fb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="236" width="346" height="84" as="geometry"/></mxCell><mxCell id="c27" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="334" as="sourcePoint"/><mxPoint x="830" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="360" width="1620" height="259" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;3. Worked out&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="370" width="136" height="24" as="geometry"/></mxCell><mxCell id="c30" value="A to F" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="394" width="136" height="219" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;A. What is an issue&lt;/b&gt;&lt;br&gt;1. A Critical or Major event with their username today.&lt;br&gt;2. More Major actions by this time of day than on any of their own days before (their latest 5 days with a PC in use, any day of the week; 3 needed). Each action is judged by its own time of day.&lt;br&gt;3. A slow start-up: longer than every one of theirs in 30 days (5 needed) and longer than 1 in 10 of everyone&#x27;s today." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="374" width="468" height="129" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;B. Spells&lt;/b&gt;&lt;br&gt;Slow actions are one issue while they go on. The spell is over after 60 minutes with no Major action, or when the day is back within their usual. A later one is a new issue. Events of one kind are grouped the same way." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="676" y="374" width="468" height="129" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;C. The alert light&lt;/b&gt;&lt;br&gt;A tile lights while a read brought more of an issue than was seen before, whatever the rows&#x27; own time. It goes off at the 3rd read after that. A failing disk stays lit all day. A restart does not light old issues again." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1162" y="374" width="468" height="129" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;D. The investigation&lt;/b&gt;&lt;br&gt;Queued while one of today&#x27;s issues is not covered by the latest one. Its window: from 30 minutes before their first issue of the day to now." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="521" width="468" height="84" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;E. Order of the tiles&lt;/b&gt;&lt;br&gt;Lit tiles first (a failing disk, Critical, Major; an event before slow actions), then users not seen in 8 days, then OK. Inside each group: the list&#x27;s own order, set by &quot;Arrange tiles&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="676" y="521" width="468" height="84" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;F. The bars on a tile&lt;/b&gt;&lt;br&gt;Their Major actions by this time of day on each of the last 8 days, today last. The days of the usual are dark; a day not read is dashed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d6676;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1162" y="521" width="468" height="84" as="geometry"/></mxCell><mxCell id="c37" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="627" width="1620" height="112" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Safety rules&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="637" width="136" height="24" as="geometry"/></mxCell><mxCell id="c39" value="They guard the checks above" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="661" width="136" height="72" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;No usual, no verdict&lt;/b&gt;&lt;br&gt;Too few days with a PC in use, or their history cut short: the tile says &quot;not compared&quot; and why. It is read again at the next check." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="641" width="346" height="84" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Start-ups not read whole&lt;/b&gt;&lt;br&gt;A read cut short is no comparison. A start-up Aternity did not record is never made up." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="641" width="346" height="84" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;The list file&lt;/b&gt;&lt;br&gt;A broken file keeps the last list and is never written over. One unreadable user file does not stop the others." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="641" width="346" height="84" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;Changes need a PIN&lt;/b&gt;&lt;br&gt;Add, remove, relabel and arrange need today&#x27;s date as a PIN, and are logged with the caller&#x27;s address. It keeps a slip out, not someone who knows the rule." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="641" width="346" height="84" as="geometry"/></mxCell><mxCell id="c44" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="739" as="sourcePoint"/><mxPoint x="830" y="765" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="765" width="1620" height="112" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;4. On the page&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="775" width="136" height="24" as="geometry"/></mxCell><mxCell id="c47" value="One tile per user" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="799" width="136" height="72" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;A lit tile&lt;/b&gt;&lt;br&gt;Its issues, the most serious first, each with when Aternity sent it and &quot;Clears at the HH:MM read if no new one&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="779" width="346" height="84" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;An OK tile&lt;/b&gt;&lt;br&gt;The day&#x27;s counts against their usual by now, and their latest Major actions (3 on the tile, all under Show more)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="779" width="346" height="84" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Title and AD&lt;/b&gt;&lt;br&gt;The typed label, else the name from AD; department; &quot;disabled in AD&quot; or &quot;not in AD&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="779" width="346" height="84" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Show more&lt;/b&gt;&lt;br&gt;Today&#x27;s issues, those that are over, the last issue before today, each start-up of today against theirs and everyone&#x27;s, and the investigation&#x27;s title." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="779" width="346" height="84" as="geometry"/></mxCell><mxCell id="c52" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5d6676;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="877" as="sourcePoint"/><mxPoint x="830" y="903" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="903" width="1620" height="112" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;5. By a click&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1d2330;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="913" width="136" height="24" as="geometry"/></mxCell><mxCell id="c55" value="And the feed for another platform" style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=top;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="34" y="937" width="136" height="72" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;Change the list&lt;/b&gt;&lt;br&gt;&quot;+ Add a user&quot; (by username, or found by name in AD), &quot;Remove from the Care list&quot;, &quot;Change label&quot;, &quot;Arrange tiles&quot; (drag, arrows or keys)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="190" y="917" width="346" height="84" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;Investigate&lt;/b&gt;&lt;br&gt;&quot;Investigate again now&quot; runs one for the same window. The saved one opens without a re-run." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="917" width="346" height="84" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;Open in Start-ups&lt;/b&gt;&lt;br&gt;From a slow start-up: that tab, for that user." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="918" y="917" width="346" height="84" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;Status feed&lt;/b&gt;&lt;br&gt;Another platform asks every 5 minutes: each user alert / ok / unknown, since when, a summary of at most 120 characters in our own words. Times in UTC." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#6b3fa0;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=top;arcSize=4;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1282" y="917" width="346" height="84" as="geometry"/></mxCell><mxCell id="c60" value="The numbers are the code&#x27;s own settings on the day the drawing was made. Names of PCs and users are never in a saved count unless said." style="text;html=1;fontSize=11;fontColor=#5d6676;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="1023" width="1620" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>